# Formulário de contato (Formspree)
# Crie uma conta em https://formspree.io e crie um formulário para obter o ID
# Copie este arquivo para .env e preencha o valor
VITE_FORMSPREE_ID=seu_id_do_formspree

# Google Analytics (GA4)
# Crie uma propriedade em https://analytics.google.com e copie o ID de medição (ex: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
